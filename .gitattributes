# Normalize line endings for all files that Git considers text files.
* text=auto eol=lf

# Godot Asset Library (Addons): only ship the plugin folder in the download ZIP.
# See: https://docs.godotengine.org/en/stable/community/asset_library/submitting_to_assetlib.html
/** export-ignore
/addons !export-ignore
/addons/** !export-ignore

# Never ship the test harness even if it lives under addons/.
/addons/gdUnit4 export-ignore
/addons/gdUnit4/** export-ignore

# Pro must never appear in the Free Asset Library ZIP (belt-and-suspenders for the pro workspace).
/addons/ui_flow_pro export-ignore
/addons/ui_flow_pro/** export-ignore
